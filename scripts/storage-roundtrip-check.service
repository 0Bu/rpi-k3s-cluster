[Unit]
Description=Storage round-trip integrity check (node_exporter textfile)
Documentation=https://github.com/0Bu/rpi-k3s-cluster/blob/main/scripts/README.md
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/storage-roundtrip-check.sh nvme0n1
# Keep the check out of the way of the cluster it is monitoring.
Nice=10
IOSchedulingClass=idle
